<Window x:Class="basket2.MainMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Main Menu" Height="600" Width="800">
    <Grid>
        <Image Source="images/WhatsApp Image 2025-03-30 at 16.56.11_489febee.jpg"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch" />
        
        <ComboBox x:Name="gameTypeComboBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" Margin="20,20,0,0"/>

        <DataGrid x:Name="gameTable"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Width="760"
                  Height="400"
                  Margin="20,60,0,0"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Team A" Binding="{Binding TeamA}" />
                <DataGridTextColumn Header="Team B" Binding="{Binding TeamB}" />
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" />
                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}" />
                <DataGridTextColumn Header="Seats" Binding="{Binding Seats}" />
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,500,0,0">
            <Button x:Name="purchaseButton" Content="Purchase" Width="120" Margin="0,0,20,0" Click="PurchaseButton_Click"/>
            <Button x:Name="logoutButton" Content="Logout" Width="120" Click="LogoutButton_Click"/>
        </StackPanel>
    </Grid>
</Window>