<Window x:Class="basket2.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="300" Width="400">
    <Grid>
        <Image Source="/images/WhatsApp Image 2025-03-30 at 16.56.24_6334e467.jpg"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch" />
        <TextBox x:Name="UsernameTextBox" HorizontalAlignment="Center" VerticalAlignment="Top" Width="200" Margin="0,50,0,0" />
        <PasswordBox x:Name="PasswordBox" HorizontalAlignment="Center" VerticalAlignment="Top" Width="200" Margin="0,100,0,0"/>
        <Label x:Name="errorMessage" Foreground="Red" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,180,0,0" />
        
        <!-- StackPanel pentru a aranja butoanele orizontal -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
            <Button Content="Login" Name="LoginButton" Width="75" Height="30" Click="LoginButton_Click" Margin="0,0,10,0"/>
            <Button Content="Sign Up" x:Name="SignUpButton" Width="75" Height="30" Click="SignUp_Click"/>
        </StackPanel>
    </Grid>
</Window>