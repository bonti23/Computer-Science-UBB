<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="247.0" prefWidth="331.0" spacing="10" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="bonti.controller.LoginView">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label text="Username:" />
    <TextField fx:id="usernameField" />

    <Label text="Password:" />
    <PasswordField fx:id="passwordField" />

    <Button onAction="#handleLogin" text="Login" />
    <Label fx:id="feedbackLabel" />
</VBox>
